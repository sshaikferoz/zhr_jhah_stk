<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <VBox visible="{violator>/isVisible}" width="100%" class="nativeViolatorStrip" wrap="Wrap">

        <!-- MAIN STRIP: Violator / Employee Details -->
        <HBox width="100%" class="nativeViolatorStrip" wrap="Wrap">

            <!-- Column 1: Primary Identity -->
            <VBox class="violatorCol sapUiLargeMarginEnd sapUiSmallMarginBottom">
                <HBox class="violatorRow sapUiTinyMarginBottom" alignItems="Center">
                    <Text text="Name:" class="violatorLabel sapUiTinyMarginEnd" />
                    <Text text="{violator>/UserName}" class="violatorValue" />
                </HBox>
                <HBox class="violatorRow" alignItems="Center">
                    <Text text="JHAH ID:" class="violatorLabel sapUiTinyMarginEnd" />
                    <Text text="{violator>/Pernr}" class="violatorValue" />
                </HBox>
            </VBox>

            <!-- Column 2: Organization & Role -->
            <VBox class="violatorCol sapUiLargeMarginEnd sapUiSmallMarginBottom">
                <HBox class="violatorRow sapUiTinyMarginBottom" alignItems="Center">
                    <Text text="Org:" class="violatorLabel sapUiTinyMarginEnd" />
                    <Text text="{violator>/OrgText}" class="violatorValue" />
                </HBox>
                <HBox class="violatorRow" alignItems="Center">
                    <!-- NOTE: 'PostionText' kept as-is assuming it's an ABAP backend typo -->
                    <Text text="Job:" class="violatorLabel sapUiTinyMarginEnd" />
                    <Text text="{violator>/PostionText}" class="violatorValue" />
                </HBox>
            </VBox>

            <!-- Column 3: Security & Access -->
            <VBox class="violatorCol sapUiLargeMarginEnd sapUiSmallMarginBottom">
                <HBox class="violatorRow sapUiTinyMarginBottom" alignItems="Center">
                    <Text text="Badge:" class="violatorLabel sapUiTinyMarginEnd" />
                    <Text text="{violator>/BadgeNumber}" class="violatorValue" />
                </HBox>
                <HBox class="violatorRow" alignItems="Center">
                    <Text text="Gov ID:" class="violatorLabel sapUiTinyMarginEnd" />
                    <Text text="{violator>/GovernmentID}" class="violatorValue" />
                </HBox>
            </VBox>

            <!-- Column 4: Contact Details -->
            <VBox class="violatorCol sapUiLargeMarginEnd sapUiSmallMarginBottom">
                <HBox class="violatorRow sapUiTinyMarginBottom" alignItems="Center">
                    <Text text="Login ID:" class="violatorLabel sapUiTinyMarginEnd" />
                    <Text text="{violator>/Usrid}" class="violatorValue" />
                </HBox>
                <HBox class="violatorRow" alignItems="Center">
                    <Text text="Email:" class="violatorLabel sapUiTinyMarginEnd" />
                    <Text text="{violator>/EMail}" class="violatorValue" />
                </HBox>
            </VBox>

            <!-- Column 5: Personal Information -->
            <VBox class="violatorCol sapUiLargeMarginEnd sapUiSmallMarginBottom">
                <HBox class="violatorRow sapUiTinyMarginBottom" alignItems="Center">
                    <Text text="Nationality:" class="violatorLabel sapUiTinyMarginEnd" />
                    <Text text="{violator>/NationalityDesc}" class="violatorValue" />
                </HBox>
                <HBox class="violatorRow" alignItems="Center">
                    <Text text="Gender:" class="violatorLabel sapUiTinyMarginEnd" />
                    <Text text="{violator>/gender}" class="violatorValue" />
                </HBox>
            </VBox>

            <!-- Column 6: DOB (DD/MM/YYYY) & Blood Group -->
            <VBox class="violatorCol sapUiLargeMarginEnd sapUiSmallMarginBottom">
                <HBox class="violatorRow sapUiTinyMarginBottom" alignItems="Center">
                    <Text text="Date of Birth:" class="violatorLabel sapUiTinyMarginEnd" />
                    <!-- Converts 19830101 to 01/01/1983 safely -->
                    <Text text="{= ${violator>/DOB} ? (${violator>/DOB}.length === 8 ? ${violator>/DOB}.substring(6,8) + '/' + ${violator>/DOB}.substring(4,6) + '/' + ${violator>/DOB}.substring(0,4) : ${violator>/DOB}) : '' }" class="violatorValue" />
                </HBox>
                <HBox class="violatorRow" alignItems="Center">
                    <Text text="Blood Group:" class="violatorLabel sapUiTinyMarginEnd" />
                    <Text text="{violator>/BloodGroup}" class="violatorValue" />
                </HBox>
            </VBox>

            <!-- Column 7: Department & CSuite -->
            <VBox class="violatorCol sapUiSmallMarginBottom">
                <HBox class="violatorRow sapUiTinyMarginBottom" alignItems="Center">
                    <Text text="Department:" class="violatorLabel sapUiTinyMarginEnd" />
                    <Text text="{violator>/Department}" class="violatorValue" />
                </HBox>
                <HBox class="violatorRow" alignItems="Center">
                    <Text text="CSuite:" class="violatorLabel sapUiTinyMarginEnd" />
                    <Text text="{violator>/CSuiteName}" class="violatorValue" />
                </HBox>
            </VBox>

        </HBox>
    </VBox>
</core:FragmentDefinition>